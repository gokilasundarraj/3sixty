# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes).
# Render env var — set this to your exact Vercel production URL.
# *.vercel.app preview deployments are always allowed automatically.
# http://localhost:5173 is always allowed automatically (dev).
CORS_ORIGINS=https://your-project.vercel.app

# ─── Database (MongoDB Atlas) ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/3sixty_db?retryWrites=true&w=majority

# ─── Cloudinary (optional — profile photo uploads) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Gmail SMTP (optional — OTP / notifications) ─────────────────────────────
SMTP_USER=projectmediasolutionsixty@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM=projectmediasolutionsixty@gmail.com
